# SQLite by default; for Neon/Supabase use postgresql+psycopg2://user:pass@host/db
DATABASE_URL=sqlite:///./suuplan.db
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5173
# Optional: without it the helper runs in FAQ mode
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
NOMINATIM_USER_AGENT=SuuPlan/0.1 (contact: team@example.com)
SUUPLAN_EXTERNAL_DATA=1
